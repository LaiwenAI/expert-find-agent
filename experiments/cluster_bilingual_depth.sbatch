#!/bin/bash
#SBATCH --job-name=intent-depth
#SBATCH --partition=gpu
#SBATCH --nodelist=ws5
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=12G
#SBATCH --gres=gpu:1
#SBATCH --time=00:20:00
#SBATCH --output=/media/Ws5_4TB/zdx/expert-find-agent/logs/intent-depth-%j.out
#SBATCH --error=/media/Ws5_4TB/zdx/expert-find-agent/logs/intent-depth-%j.err
set -euo pipefail
cd /media/Ws5_4TB/zdx/expert-find-agent
export PYTHONPATH="$PWD/src"
export OPENBLAS_NUM_THREADS=1
export OMP_NUM_THREADS=1
venv/bin/python -u -m experiments.bilingual.all_intent_depth_diagnostic --output artifacts/bilingual-all-depth-diagnostic-v1
